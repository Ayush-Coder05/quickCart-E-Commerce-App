{
  "expo": {
    "name": "quickCart",
    "slug": "quickCart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cart-logo.png",
    "scheme": "quickcart",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ayushcoder05.quickcart",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/cart-logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/cart-logo.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "edgeToEdgeEnabled": true
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "firebase": {
        "apiKey": "AIzaSyDhQ166kRf-WO4xclX-NvSy2j8dtEyMCTw",
        "authDomain": "quickcart-shared.firebaseapp.com",
        "projectId": "quickcart-shared",
        "storageBucket": "quickcart-shared.firebasestorage.app",
        "messagingSenderId": "221503732530",
        "appId": "1:221503732530:web:f7e20e123bec7f36ceb52b",
        "measurementId": "G-ES1M12WKE6"
      },
      "router": {},
      "eas": {
        "projectId": "bde50b43-91f0-4967-b5b8-b8ad12839883"
      },
      "otpUrl": "https://quickcart-otp-server.onrender.com"
    }
  }
}

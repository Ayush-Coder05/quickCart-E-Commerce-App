rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Default open for other collections to not break existing app demo state
    match /users/{userId} {
      allow read, write: if true;
    }
    match /products/{docId} {
      allow read, write: if true;
    }
    match /categories/{docId} {
      allow read, write: if true;
    }
    match /cities/{docId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      // Users can only edit their own orders, and cannot edit delivered orders.
      allow read: if true; // allow read if true for easy demo access
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.userId && resource.data.status != 'delivered') || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /supportChats/{chatId} {
      // Users can only access their own chats, admins can access all
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
